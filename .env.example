NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cedugames
JWT_SECRET=generate-a-random-secret-with-at-least-32-characters
# Optional until Google authentication is enabled:
# GOOGLE_CLIENT_ID=
ZOHO_MAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZOHO_MAIL_API_TOKEN=
ZOHO_MAIL_FROM=noreply@example.com
ZOHO_MAIL_FROM_NAME=CeduGames
EMAIL_VERIFICATION_ENABLED=false
MAIL_SEND_TIMEOUT_MS=10000
CORS_ORIGINS=https://cedugames-admin.onrender.com/,https://cedugames-user.onrender.com
SUPER_ADMIN_EMAIL=cedugames@gmail.com
SUPER_ADMIN_PASSWORD=Admin@1234
FLW_SECRET_KEY=
# Must match the secret configured in Flutterwave Dashboard > Settings > Webhooks.
FLW_SECRET_HASH=
FLW_REDIRECT_URL=https://cedugames-user.onrender.com/shop
# Optional: required only for admin AI question generation.
OPENAI_API_KEY=
OPENAI_QUESTION_MODEL=gpt-5.6
OPENAI_TIMEOUT_MS=60000
